{
  "name": "bytune",
  "productName": "ByTune",
  "version": "1.0.23",
  "description": "Desktop client for YouTube Music",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "icon": "node scripts/make-icon.mjs",
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "dist": "node scripts/make-icon.mjs && electron-builder --win --publish never",
    "release": "node scripts/release.mjs"
  },
  "build": {
    "appId": "local.youtube-music-client",
    "productName": "ByTune",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "build/thumb-*.png"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ByTune-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ByTune-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Jscruzgg",
        "repo": "ByTune"
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
